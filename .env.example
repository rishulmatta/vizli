# Optional. With no keys, Vizli runs in labelled deterministic demo mode.
# Copy this file to .env in the repository root. Never put secrets in VITE_* variables.
# Run pnpm check:hackathon before deployment; passing config still needs live verification.
NEBIUS_API_KEY=
# Documented NVIDIA Nemotron model ID; verify access with your Token Factory account.
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
# Optional Nemotron model for creating scenes; empty defaults to NEBIUS_MODEL.
NEBIUS_PLANNING_MODEL=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# NVIDIA-hosted Nemotron ASR. This key is separate from the Nebius key above.
NVIDIA_API_KEY=
NVIDIA_ASR_ENDPOINT=grpc.nvcf.nvidia.com:443
NVIDIA_ASR_FUNCTION_ID=bb0837de-8c7b-481f-9ec8-ef5663e9c1fa
NVIDIA_ASR_LANGUAGE_CODE=en-US
# Server port. The Vite dev proxy and default ALLOWED_ORIGINS follow this value, so change it here if 3001 is busy.
PORT=3001
HOST=127.0.0.1
# Lightweight single-server hackathon limits; nonnegative integers (0 disables capacity).
# These are usage limits, not provider billing guarantees. Counters reset on restart.
MAX_CONCURRENT_VOICE_SESSIONS=5
MAX_VOICE_SECONDS_PER_SESSION=600
MAX_LLM_REQUESTS_PER_HOUR=1200
MAX_CONCURRENT_LLM_REQUESTS=3
# Optional local project directory; server defines its default under ignored .data.
# DATA_DIR=

# Legacy optional Supabase integration. Railway Postgres + R2 is now the preferred
# deployment direction, but those adapters are not implemented yet.
# Optional browser cloud configuration belongs in apps/web/.env.local:
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-public-anon-key
# Apply supabase/migrations/202610080001_projects.sql first; see docs/CLOUD.md.
# Never use a service-role key in the browser.
